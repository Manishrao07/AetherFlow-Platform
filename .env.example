# Copy to .env for local (non-Docker) runs. Docker Compose has its own safe dev defaults,
# so `docker compose up --build` works with no .env at all. NEVER commit a real .env.

# --- App -------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true                      # false = human-readable logs for local debugging

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://wf:wf@localhost:5432/wf
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_RETRIES=20              # startup retry: wait for Postgres instead of crashing
DB_CONNECT_RETRY_DELAY_SECONDS=1.0

# --- Redis (optional: caching + rate limiting; falls back to in-process) ----
REDIS_URL=

# --- Auth ------------------------------------------------------------------
# Must be >= 32 chars. In production the "change-me" placeholder is rejected.
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501   # comma separated
MAX_REQUEST_BYTES=2097152
TRUST_PROXY_HEADERS=false          # true only behind a trusted reverse proxy

# --- Rate limiting (per client IP; Redis-backed when REDIS_URL is set) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10      # login / register / refresh

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=mock                  # mock (no key needed) | anthropic | groq | gemini
LLM_MODEL=                         # required for anthropic/groq/gemini (never hardcoded)
LLM_FALLBACK_MODEL=                # optional backup model (groq) used if the primary is rate-limited or down
ANTHROPIC_API_KEY=                 # required when LLM_PROVIDER=anthropic
GROQ_API_KEY=                      # required when LLM_PROVIDER=groq
GEMINI_API_KEY=                    # required when LLM_PROVIDER=gemini (comma-separated list supported for load balancing)
LLM_REQUESTS_PER_MINUTE=           # max provider requests/min (0 = unlimited; blank = 8 for gemini, unlimited otherwise)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3                 # per call, with exponential backoff + jitter
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_BREAKER_FAILURE_THRESHOLD=5    # consecutive failures before the circuit opens
LLM_BREAKER_RECOVERY_SECONDS=30
LLM_INPUT_COST_PER_MTOK=0          # USD per million input tokens (cost estimate)
LLM_OUTPUT_COST_PER_MTOK=0         # USD per million output tokens

# --- Tools -------------------------------------------------------------------
HTTP_FETCH_ALLOWED_HOSTS=example.com   # comma separated; default-deny SSRF allow-list
HTTP_FETCH_TIMEOUT_SECONDS=10
HTTP_FETCH_MAX_BYTES=1048576
TOOL_OUTPUT_MAX_CHARS=20000

# --- Agents & memory -----------------------------------------------------------
MAX_PLAN_STEPS=10                  # planner output is rejected above this
RETRIEVAL_TOP_K=5
REVIEW_MIN_SCORE=0.7               # APPROVED verdicts scoring below this are downgraded
SHORT_TERM_TOKEN_BUDGET=2000       # tokens of chat history sent to agents
SHORT_TERM_KEEP_RECENT=6           # newest messages kept verbatim before summarising
SUMMARY_MAX_TOKENS=300
DOCUMENT_MAX_CHARS=200000

# --- Orchestrator ----------------------------------------------------------------
WORKER_ENABLED=true                # false = API only; run the worker in another process
MAX_CONCURRENT_RUNS=4              # runs driven at the same time per process
MAX_PARALLEL_STEPS=4               # independent steps of one run executed concurrently
STEP_MAX_ATTEMPTS=3                # tries per step (retryable errors only)
STEP_RETRY_BASE_DELAY_SECONDS=0.5  # exponential backoff with full jitter
STEP_RETRY_MAX_DELAY_SECONDS=8
DEFAULT_MAX_REVISIONS=2            # review-driven re-plans before the run fails
APPROVAL_TTL_SECONDS=86400         # pending approvals expire after this long
RUN_LEASE_SECONDS=30               # a worker silent for this long loses its run
SWEEP_INTERVAL_SECONDS=15          # orphan recovery + approval expiry cadence
SSE_POLL_INTERVAL_SECONDS=0.5

# --- Observability ---------------------------------------------------------------
TRACING_EXPORTER=console           # none | console (JSON span lines in the log) | otlp
TRACING_SERVICE_NAME=workflow-platform
OTLP_ENDPOINT=                     # required for otlp, e.g. http://otel-collector:4318/v1/traces
METRICS_TOKEN=                     # optional: require "Authorization: Bearer ..." on /metrics
WORKER_METRICS_PORT=               # optional: /metrics port of a stand-alone worker process

# --- Caching ---------------------------------------------------------------------
CACHE_ENABLED=true                 # uses REDIS_URL when set, otherwise an in-process TTL cache
CACHE_MAX_ENTRIES=1000             # in-process cache size (LRU)
RETRIEVAL_CACHE_TTL_SECONDS=60
MOCK_LLM_LATENCY_SECONDS=0         # simulate model latency with LLM_PROVIDER=mock (load tests)
LLM_CACHE_ENABLED=false            # cache identical LLM requests (off: real models vary)
LLM_CACHE_TTL_SECONDS=3600

# --- Seed script -----------------------------------------------------------
SEED_DEMO_PASSWORD=Demo#Pass123

# --- Research mode ------------------------------------------------------------
TAVILY_API_KEY=                    # optional: enables the web_search source (Wikipedia, arXiv and your documents need no key)
DEEP_RESEARCH_MAX_QUESTIONS=4      # sub-questions (= parallel research steps) per deep run, 2-6
RESEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_RESULTS=5

# --- Embeddings (semantic search) -------------------------------------------------
EMBEDDING_PROVIDER=hash            # hash (offline, no key) | openai (any OpenAI-compatible /embeddings) | none
EMBEDDING_MODEL=                   # required when EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=                 # required when EMBEDDING_PROVIDER=openai
SEMANTIC_MIN_SIMILARITY=0.2        # vector-only hits below this cosine are dropped
